// No.1 & Best Pigeons — schema de date
// PostgreSQL. Campurile de tip status/rol raman String (nu enum) iar sumele
// sunt in bani/centi ca Int — schema a fost proiectata initial pe SQLite si
// pastreaza aceleasi tipuri pentru compatibilitate cu tot codul existent.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String    @id @default(cuid())
  email               String    @unique
  passwordHash        String
  name                String
  /// Numele sub care apare in istoricul ofertelor. Public — numele real nu
  /// se arata niciodata acolo.
  nickname            String?   @unique
  phone               String?
  /// Adresa, cerută la înregistrare de la licitațiile pe loturi.
  addressStreet       String?
  addressCity         String?
  addressCounty       String?
  addressPostalCode   String?
  addressCountry      String?
  locale              String    @default("ro")
  role                String    @default("BUYER") // BUYER | SELLER | ADMIN
  sellerStatus        String? // PENDING | APPROVED | REJECTED
  sellerCompany       String?
  /// Localitatea crescatoriei. Apare pe cardul de pe prima pagina si pe profil.
  sellerCity          String?
  sellerCui           String?
  sellerIban          String?
  sellerBio           String?
  emailVerifiedAt     DateTime?
  phoneVerifiedAt     DateTime?
  bidLimitOverride    Int? // in centi; null = limita default platforma pt conturi noi
  completedOrders     Int       @default(0)
  suspendedAt         DateTime?
  /// Aprobarea contului de către administrator: PENDING | APPROVED | REJECTED.
  /// Conturile de dinainte rămân aprobate — valoarea implicită e APPROVED.
  accountStatus       String    @default("APPROVED")
  accountReviewedAt   DateTime?
  accountReviewedById String?
  accountRejectReason String?
  /// A bifat „Vreau să primesc un aviz când se încheie o licitație".
  notifyAuctionEnding Boolean   @default(false)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  pigeons         Pigeon[]
  bids            Bid[]
  watchlist       WatchItem[]
  ordersAsBuyer   Order[]              @relation("buyer")
  ordersAsSeller  Order[]              @relation("seller")
  reviewsGiven    Review[]             @relation("reviewAuthor")
  reviewsReceived Review[]             @relation("reviewSeller")
  notifications   Notification[]
  auditLogs       AuditLog[]
  resetTokens     PasswordResetToken[]
  auctionsWon     Auction[]            @relation("winner")
  approvedLots    Auction[]            @relation("approver")
  shopOrders      ShopOrder[]          @relation("shopBuyer")
}

/// Link de resetare a parolei. In baza se tine doar amprenta (sha256) —
/// tokenul in clar exista doar in linkul trimis utilizatorului.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  /// se completeaza la prima folosire — un link merge o singura data
  usedAt    DateTime?
  /// „SELF" = cerut de utilizator, „ADMIN" = generat din panou
  issuedBy  String    @default("SELF")
  createdAt DateTime  @default(now())

  @@index([userId, usedAt])
}

model Pigeon {
  id           String  @id @default(cuid())
  sellerId     String
  seller       User    @relation(fields: [sellerId], references: [id])
  ringNumber   String // ex: RO 2024 123456
  birthYear    Int
  sex          String // M | F | U
  color        String?
  strain       String? // linia/rasa (ex. Janssen, Van Loon)
  category     String  @default("RACING") // RACING | FANCY
  /// Numele porumbelului, ca pe pipa.be ("Mittwoch"). Nu se traduce.
  name         String
  /// Randul scurt de sub nume ("1. As & Medalie de argint!"). Bilingv.
  taglineRo    String?
  taglineEn    String?
  descRo       String?
  descEn       String?
  /// Cine l-a reprodus (crescatorul de origine) si cine il ofera la licitatie.
  /// Text liber: de multe ori nu sunt conturi pe platforma.
  bredBy       String?
  offeredBy    String?
  /// Scanul pedigree-ului (poza sau PDF). Arborele pe campuri ramane optional.
  pedigreeUrl  String?
  pedigreeJson String? // arbore genealogic serializat JSON (max 4 generatii)
  /// Caracteristicile din fisa de tip pipa (ochi, constitutie, aripa) — JSON,
  /// cu chei si valori dintr-o lista fixa (vezi src/lib/pigeon-traits.ts)
  traitsJson   String?
  dnaCertified Boolean @default(false)

  results PigeonResult[]
  media   MediaAsset[]
  auction Auction?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PigeonResult {
  id           String  @id @default(cuid())
  pigeonId     String
  pigeon       Pigeon  @relation(fields: [pigeonId], references: [id], onDelete: Cascade)
  raceName     String
  year         Int?
  distanceKm   Int?
  place        Int
  participants Int?
  note         String?
}

model MediaAsset {
  id       String  @id @default(cuid())
  pigeonId String
  pigeon   Pigeon  @relation(fields: [pigeonId], references: [id], onDelete: Cascade)
  type     String // IMAGE | VIDEO | DOCUMENT
  url      String
  title    String?
  sortIdx  Int     @default(0)
}

model Auction {
  id                   String    @id @default(cuid())
  pigeonId             String    @unique
  pigeon               Pigeon    @relation(fields: [pigeonId], references: [id])
  sellerId             String
  status               String    @default("PENDING_APPROVAL") // DRAFT | PENDING_APPROVAL | REJECTED | SCHEDULED | LIVE | CLOSED | CANCELLED
  rejectReason         String?
  listingType          String    @default("SELF") // SELF | ASSISTED
  // AUCTION = licitatie clasica; FIXED = pret fix, primul care apasa "Cumpara acum" ia lotul
  saleMode             String    @default("AUCTION") // AUCTION | FIXED
  contestId            String?
  contest              Contest?  @relation(fields: [contestId], references: [id])
  currency             String    @default("EUR")
  startPriceCents      Int
  currentPriceCents    Int       @default(0)
  minIncrementOverride Int?
  startsAt             DateTime
  endsAt               DateTime
  originalEndsAt       DateTime
  extensionsCount      Int       @default(0)
  /// cand s-a trimis anuntul „se apropie finalul" — ca sa nu plece de zeci de ori
  endingNotifiedAt     DateTime?
  winnerId             String?
  winner               User?     @relation("winner", fields: [winnerId], references: [id])
  winningBidId         String?
  /// Suma sub care vanzatorul nu vinde. Ascunsa cumparatorilor: se arata doar
  /// daca a fost atinsa sau nu. null = licitatie fara pret de rezerva.
  reservePriceCents    Int?
  /** porumbelul s-a îmbolnăvit sau a murit după licitație (clientul, Punctul 5) */
  unavailableAt        DateTime?
  unavailableReason    String?
  reserveNotMet        Boolean   @default(false)
  dnaSexGuaranteed     Boolean   @default(false)
  shippingMode         String    @default("SELLER") // SELLER | PICKUP | PLATFORM
  shippingPayer        String    @default("BUYER") // BUYER | SELLER
  approvedAt           DateTime?
  approvedById         String?
  approvedBy           User?     @relation("approver", fields: [approvedById], references: [id])
  closedAt             DateTime?
  /// Lotul din care face parte. null = licitație individuală, din fluxul vechi.
  lotId                String?
  lot                  Lot?      @relation(fields: [lotId], references: [id])
  /// Poziția în lot: 4 → „Lotul 1.04".
  lotPosition          Int?

  bids     Bid[]
  watchers WatchItem[]
  order    Order?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, endsAt])
  @@index([lotId])
}

model Bid {
  id             String   @id @default(cuid())
  auctionId      String
  auction        Auction  @relation(fields: [auctionId], references: [id])
  bidderId       String
  bidder         User     @relation(fields: [bidderId], references: [id])
  amountCents    Int // oferta vizibila la momentul plasarii
  maxAmountCents Int // plafonul proxy (secret)
  isLeading      Boolean  @default(false)
  createdAt      DateTime @default(now())

  @@index([auctionId, createdAt])
}

model WatchItem {
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  auctionId String
  auction   Auction  @relation(fields: [auctionId], references: [id])
  createdAt DateTime @default(now())

  @@id([userId, auctionId])
}

model Order {
  id              String    @id @default(cuid())
  auctionId       String    @unique
  auction         Auction   @relation(fields: [auctionId], references: [id])
  buyerId         String
  buyer           User      @relation("buyer", fields: [buyerId], references: [id])
  sellerId        String
  seller          User      @relation("seller", fields: [sellerId], references: [id])
  amountCents     Int // pretul de adjudecare
  commissionCents Int // comisionul platformei (din vanzator)
  currency        String    @default("EUR")
  status          String    @default("PENDING_PAYMENT") // PENDING_PAYMENT | PAID | SHIPPED | DELIVERED | DISPUTED | CANCELLED
  paymentRef      String?
  paidAt          DateTime?
  payoutStatus    String    @default("PENDING") // PENDING | SCHEDULED | RELEASED
  payoutAt        DateTime?
  shippingNote    String?
  review          Review?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  /// Faza 2 — plata în afara site-ului, marcată de administrator
  paymentMethod   String? // TRANSFER | CASH
  paidMarkedById  String?
  deliveredAt     DateTime?
  deliveredById   String?
  /// transportatorul, la predare (opțional)
  carrier         String?
  cancelledAt     DateTime?
  cancelReason    String?
  settlementId    String?
  settlement      Settlement? @relation(fields: [settlementId], references: [id])

  @@index([settlementId])
}

model Review {
  id            String    @id @default(cuid())
  orderId       String    @unique
  order         Order     @relation(fields: [orderId], references: [id])
  sellerId      String
  seller        User      @relation("reviewSeller", fields: [sellerId], references: [id])
  authorId      String
  author        User      @relation("reviewAuthor", fields: [authorId], references: [id])
  rating        Int // 1..5
  comment       String?
  sellerReply   String?
  // Vizibilitatea o decide DOAR adminul. O raportare pune recenzia in coada de
  // moderare (reportedAt), dar nu o scoate din public — altfel oricine ar putea
  // face sa dispara recenziile negative ale unui vanzator.
  status        String    @default("VISIBLE") // VISIBLE | HIDDEN
  reportedAt    DateTime?
  reportReason  String?
  moderNote     String?
  editableUntil DateTime
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([sellerId, status])
}

model Notification {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id])
  type       String // OUTBID | AUCTION_ENDING | AUCTION_WON | AUCTION_LOST | SELLER_SOLD | LOT_APPROVED | LOT_REJECTED | ORDER_PAID | SELLER_APPROVED | REVIEW_RECEIVED
  paramsJson String // parametri pt randare localizata
  link       String?
  readAt     DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId, readAt])
}

model EmailLog {
  id        String   @id @default(cuid())
  toEmail   String
  subject   String
  body      String
  createdAt DateTime @default(now())
}

model PlatformSetting {
  key       String   @id
  value     String // JSON serializat
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  actor     User?    @relation(fields: [actorId], references: [id])
  action    String // ex: SETTING_CHANGED, LOT_APPROVED, USER_SUSPENDED, REVIEW_HIDDEN
  entity    String?
  entityId  String?
  dataJson  String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// ─────────────────────────────────────────────────────────────────────────
// Sectiuni noi: magazin de produse, articole, concursuri, pagini editabile
// ─────────────────────────────────────────────────────────────────────────

/// Produse pentru columbofili (hrana, vitamine, accesorii, inele).
model Product {
  id         String  @id @default(cuid())
  slug       String  @unique
  nameRo     String
  nameEn     String
  descRo     String?
  descEn     String?
  category   String  @default("FEED") // FEED | SUPPLEMENTS | ACCESSORIES | RINGS | OTHER
  priceCents Int
  currency   String  @default("EUR")
  stock      Int     @default(0)
  imageUrl   String?
  active     Boolean @default(true)
  sortIdx    Int     @default(0)

  items ShopOrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active, category])
}

/// Comanda din magazin (separata de comenzile de porumbei, care sunt legate de licitatii).
model ShopOrder {
  id              String    @id @default(cuid())
  buyerId         String
  buyer           User      @relation("shopBuyer", fields: [buyerId], references: [id])
  status          String    @default("PENDING_PAYMENT") // PENDING_PAYMENT | PAID | SHIPPED | DELIVERED | CANCELLED
  subtotalCents   Int
  shippingCents   Int       @default(0)
  totalCents      Int
  currency        String    @default("EUR")
  paymentRef      String?
  paidAt          DateTime?
  shippingName    String
  shippingPhone   String
  shippingAddress String
  note            String?

  items ShopOrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([buyerId, status])
}

model ShopOrderItem {
  id           String    @id @default(cuid())
  shopOrderId  String
  shopOrder    ShopOrder @relation(fields: [shopOrderId], references: [id], onDelete: Cascade)
  productId    String
  product      Product   @relation(fields: [productId], references: [id])
  /// Denumirea si pretul se copiaza la momentul comenzii — daca produsul se
  /// schimba ulterior, comanda ramane cu ce a cumparat clientul efectiv.
  nameSnapshot String
  priceCents   Int
  quantity     Int
}

/// Articole editoriale (blog), bilingve.
model Article {
  id          String    @id @default(cuid())
  slug        String    @unique
  titleRo     String
  titleEn     String
  excerptRo   String?
  excerptEn   String?
  bodyRo      String
  bodyEn      String
  coverUrl    String?
  authorName  String    @default("No.1 & Best Pigeons")
  publishedAt DateTime?

  media     ArticleMedia[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([publishedAt])
}

/// Concursuri / campionate organizate de platforma, cu loturi dedicate.
model Contest {
  id        String   @id @default(cuid())
  slug      String   @unique
  titleRo   String
  titleEn   String
  descRo    String?
  descEn    String?
  rulesRo   String?
  rulesEn   String?
  coverUrl  String?
  startsAt  DateTime
  endsAt    DateTime
  status    String   @default("UPCOMING") // UPCOMING | ACTIVE | FINISHED
  published Boolean  @default(false)
  /// Concursul cu banda pe prima pagina. Unul singur: cand se pune pe unul, se
  /// stinge de pe restul. Fara niciunul, se alege automat cel in desfasurare.
  featured  Boolean  @default(false)

  /// Datele de pe banda de pe prima pagina, in forma ceruta de client:
  /// destinatia scrisa mare, distanta, steagul tarii, imbarcarea si lansarea.
  /// Toate optionale — o banda arata doar rubricile completate.
  destination   String?
  /// Capătul de jos al distanței; singurul, când nu e interval.
  distanceKm    Int?
  /// Capătul de sus, când crescătorii au distanțe diferite: „170-240 km".
  distanceMaxKm Int?
  /// Cod ISO de doua litere (DE, RO). Steagul se compune din el la afisare,
  /// ca sa nu tinem emoji in baza.
  countryCode   String?
  boardingAt    DateTime?
  boardingPlace String?
  releaseAt     DateTime?
  /// Link catre o sursa de vreme pentru traseu (ex. windy.com). Fara el,
  /// rubrica „Meteo pe traseu" nu apare — nu promitem ce n-avem.
  weatherUrl    String?
  sloganRo      String?
  sloganEn      String?

  auctions Auction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Pagini de continut editabile din admin (regulament, despre noi, contact...).
model ContentPage {
  id        String   @id @default(cuid())
  slug      String   @unique // regulament | info-licitatii | alte-info | transport-agenti | despre-noi | contact
  titleRo   String
  titleEn   String
  bodyRo    String
  bodyEn    String
  updatedAt DateTime @updatedAt
}

/// Mesaje trimise din formularul de contact.
model ContactMessage {
  id        String    @id @default(cuid())
  name      String
  email     String
  subject   String
  message   String
  handledAt DateTime?
  createdAt DateTime  @default(now())

  @@index([handledAt])
}

/// Linkuri catre site-uri externe, afisate ca submeniu (ex. Concursuri).
/// Editabile din admin: cand apar clasamentele 2027, Daniel schimba doar URL-ul.
model ExternalLink {
  id      String  @id @default(cuid())
  /// gruparea in meniu; deocamdata doar CONTESTS, dar modelul e reutilizabil
  group   String  @default("CONTESTS")
  labelRo String
  labelEn String
  /// null sau gol = intrare inactiva, afisata ca „in curand" (ex. One loft races)
  url     String?
  sortIdx Int     @default(0)
  active  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([group, active, sortIdx])
}

/// Poze si clipuri atasate unui articol (ordinea in care apar in pagina).
model ArticleMedia {
  id        String  @id @default(cuid())
  articleId String
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  type      String // IMAGE | VIDEO
  url       String
  sortIdx   Int     @default(0)

  @@index([articleId, sortIdx])
}

/// Abonat la newsletter.
///
/// GDPR: nu tinem doar adresa, ci si dovada consimtamantului — cand a bifat si
/// ce scria in caseta bifata. Fara textul exact, „a fost de acord" nu se poate
/// demonstra daca formularul se schimba intre timp.
model NewsletterSubscriber {
  id             String    @id @default(cuid())
  email          String    @unique
  locale         String    @default("ro")
  consentAt      DateTime  @default(now())
  consentText    String
  /// Ajunge in linkul de dezabonare din fiecare e-mail. Aleator, nu ghicibil:
  /// altfel oricine ar putea dezabona pe oricine cunoscandu-i adresa.
  unsubToken     String    @unique
  unsubscribedAt DateTime?
  createdAt      DateTime  @default(now())
}

/// Transportatorii și agenții din pagina „Transport și Agenți".
///
/// O listă, nu un bloc de text: după primul transportator nu mai era loc
/// pentru al doilea. Fiecare are cardul lui și se pot adăuga oricâți.
model ShippingAgent {
  id        String   @id @default(cuid())
  kind      String   @default("TRANSPORT") // TRANSPORT | AGENT
  name      String
  /// județe, țări sau trasee acoperite
  zone      String?
  descRo    String?
  descEn    String?
  phone     String?
  whatsapp  String?
  email     String?
  website   String?
  logoUrl   String?
  sortIdx   Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Crescătorul care vinde, ca profil. Nu are cont pe site: datele le primește
/// administratorul pe e-mail și le introduce el.
model Breeder {
  id        String   @id @default(cuid())
  name      String
  city      String?
  country   String?
  photoUrl  String?
  storyRo   String?
  storyEn   String?
  resultsRo String?
  resultsEn String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sales Sale[]
}

/// Licitația unui crescător — „Licitația Burca Ionuț". Până la 5 loturi.
/// Perioada nu se ține aici: vine din loturi, ca să nu existe două ore care se
/// contrazic.
model Sale {
  id                String   @id @default(cuid())
  slug              String   @unique
  breederId         String
  breeder           Breeder  @relation(fields: [breederId], references: [id])
  titleRo           String
  titleEn           String
  descRo            String?
  descEn            String?
  coverUrl          String?
  /// Comisionul reținut crescătorului, în procente. Cumpărătorul nu îl vede și
  /// nu plătește nimic în plus, deci se poate schimba și după pornire.
  commissionPercent Float    @default(12)
  createdById       String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  lots Lot[]
}

/// Un lot: până la 20 de porumbei care pornesc și se închid împreună.
model Lot {
  id                 String    @id @default(cuid())
  saleId             String
  sale               Sale      @relation(fields: [saleId], references: [id])
  number             Int
  startsAt           DateTime
  endsAt             DateTime
  status             String    @default("DRAFT") // DRAFT | SCHEDULED | LIVE | CLOSED
  /// Regulile de prelungire, înghețate la „Start lot": o schimbare în Setări
  /// nu atinge un lot deja pornit.
  snipeWindowMinutes Int?
  extensionMinutes   Int?
  /// 0 = fără limită
  maxExtensions      Int?
  startedAt          DateTime?
  startedById        String?
  /// Când a plecat avizul „se încheie în 30 de minute" — o singură dată pe lot.
  endingNotifiedAt   DateTime?
  closedAt           DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  auctions Auction[]

  @@unique([saleId, number])
  @@index([status, endsAt])
}

/// Decontul cu crescătorul (faza 2): porumbeii plătiți dintr-o licitație de
/// crescător sau, la preț fix, cei cu același „Oferit de". Sumele rămân cele
/// din ziua decontului.
model Settlement {
  id              String   @id @default(cuid())
  kind            String // SALE | FIXED
  saleId          String?
  offeredBy       String?
  currency        String   @default("RON")
  totalCents      Int
  commissionCents Int
  payoutCents     Int
  orderCount      Int
  note            String?
  settledById     String?
  settledAt       DateTime @default(now())
  orders          Order[]

  @@index([saleId])
  @@index([offeredBy])
}
